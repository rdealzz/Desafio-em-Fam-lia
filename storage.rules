rules_version = '2';

// Fotos comprovante e avatares.
service firebase.storage {
  match /b/{bucket}/o {

    // families/{familyId}/proofs/{userId}/{arquivo}
    match /families/{familyId}/proofs/{userId}/{fileName} {
      // Leitura para qualquer usuário autenticado: o Storage não consegue
      // consultar o Firestore, então o recorte por família fica no app.
      allow read: if request.auth != null;

      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // avatars/{userId}/perfil.jpg — cada um só escreve na própria pasta.
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 4 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
