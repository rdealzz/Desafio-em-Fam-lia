rules_version = '2';

// Regras do "Desafio em Família".
//
// Princípio: os dados são privados da família. Só quem está no mesmo
// `familyId` lê o cofre, os registros e o mural.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // familyId do usuário autenticado (1 leitura extra, aceitável no MVP).
    function myFamilyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.familyId;
    }

    function sameFamily(familyId) {
      return isSignedIn() && familyId != null && familyId == myFamilyId();
    }

    // Exigência de foto lida do documento da família. Ausente = exigida:
    // o padrão seguro é pedir a prova, não dispensá-la.
    function familyRequiresPhoto(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId))
             .data.get('requirePhotoProof', true) == true;
    }

    // `request.time` é o relógio do SERVIDOR no momento da escrita — o app não
    // tem como forjar. Um registro só é aceito se a hora declarada couber numa
    // janela plausível em volta dela.
    //
    // Sem isso, bastava atrasar o relógio do celular para "salvar" uma
    // sequência perdida, que é justamente a graça de ter sequência.
    //
    // 5 min de folga para frente absorvem desencontro normal de relógio;
    // 48 h para trás é o mesmo prazo da fila offline.
    function plausibleTimestamp() {
      return request.resource.data.createdAt is timestamp &&
             request.resource.data.createdAt <=
               request.time + duration.value(5, 'm') &&
             request.resource.data.createdAt >=
               request.time - duration.value(48, 'h');
    }

    // A foto comprovante vai DENTRO do documento, em base64: projeto sem o
    // plano Blaze não tem Storage. `photoUrl` ainda conta porque registro
    // antigo, de quando havia Storage, guardou endereço.
    function hasPhotoProof() {
      return (request.resource.data.get('photoData', '') is string &&
              request.resource.data.get('photoData', '').size() > 0) ||
             (request.resource.data.get('photoUrl', '') is string &&
              request.resource.data.get('photoUrl', '').size() > 0);
    }

    // Teto do texto da foto. O documento do Firestore para em 1 MiB, e o app
    // já pede a foto pequena à câmera; isto é a rede de segurança do servidor
    // contra um cliente adulterado entupir a coleção.
    function photoWithinLimit() {
      return request.resource.data.get('photoData', '') == null ||
             request.resource.data.get('photoData', '').size() <= 200000;
    }

    // A foto vale um dia e depois é apagada por quem abrir o app (não há
    // Function para isso). Só os dois campos da foto vão a zero, e só depois
    // da hora marcada — ninguém apaga a prova alheia antes do prazo.
    function clearingExpiredPhoto() {
      return changedKeys().hasOnly(['photoData', 'photoExpiresAt']) &&
             request.resource.data.get('photoData', null) == null &&
             resource.data.get('photoExpiresAt', null) is timestamp &&
             request.time > resource.data.photoExpiresAt;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- users ------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || sameFamily(resource.data.familyId));

      allow create: if isSignedIn() && request.auth.uid == userId;

      // O próprio dono edita tudo. Um integrante da mesma família só pode
      // mexer nos campos que a Carta Salva-Mãe/Pai altera.
      //
      // TODO (escala): mover a doação para uma Cloud Function e remover o
      // segundo ramo — aí nenhum cliente escreve no perfil alheio.
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        (sameFamily(resource.data.familyId) && changedKeys().hasOnly([
          'weeklyPoints', 'totalPoints', 'weekId', 'currentStreak',
          'longestStreak', 'lastActivityAt', 'statusMessage', 'updatedAt'
        ]))
      );

      allow delete: if false;
    }

    // --- usernames --------------------------------------------------------
    // Mapa apelido → conta. A tela de entrada precisa lê-lo ANTES de haver
    // sessão, para descobrir com qual e-mail o Firebase conhece a pessoa — é
    // o que deixa cadastrar e-mail de recuperação sem quebrar o login por
    // apelido.
    //
    // `get` liberado, `list` não: quem souber um apelido lê aquele apelido, e
    // ninguém varre a coleção atrás dos e-mails da família. O documento não
    // guarda senha nem nada derivado dela — saber o e-mail de alguém não abre
    // porta nenhuma.
    match /usernames/{apelido} {
      allow get: if true;
      allow list: if false;

      // Cada um escreve só o próprio: o documento precisa apontar para o uid
      // de quem está escrevendo, e um apelido já tomado não muda de dono.
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // --- families ---------------------------------------------------------
    match /families/{familyId} {
      // Leitura liberada para quem já é membro; a busca por código de convite
      // acontece antes de entrar, por isso o segundo termo.
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.memberIds.hasAny([request.auth.uid]);

      allow update: if isSignedIn() && (
        sameFamily(familyId) ||
        // entrar na família: só pode acrescentar o próprio uid
        (changedKeys().hasOnly(['memberIds']) &&
         request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
         request.resource.data.memberIds.size() <= 4)
      );

      allow delete: if false;
    }

    // --- activity_logs ----------------------------------------------------
    match /activity_logs/{logId} {
      allow read: if sameFamily(resource.data.familyId);

      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        sameFamily(request.resource.data.familyId) &&
        request.resource.data.points is int &&
        request.resource.data.points > 0 &&
        request.resource.data.points <= 2000 &&
        // A foto comprovante é regra de integridade, não só de interface:
        // sem ela o registro é recusado pelo servidor.
        (hasPhotoProof() ||
         !familyRequiresPhoto(request.resource.data.familyId)) &&
        photoWithinLimit() &&
        // A hora declarada tem de bater com o relógio do servidor.
        plausibleTimestamp() &&
        // Quando chegou, na hora do servidor: é o contraponto ao que o
        // aparelho declara, e o que revela um registro atrasado.
        request.resource.data.syncedAt == request.time;

      // Histórico é imutável: correções entram como novo registro. A única
      // exceção é apagar a foto vencida — pontos, hora e tipo não se mexem.
      allow update: if sameFamily(resource.data.familyId) &&
        clearingExpiredPhoto();
      allow delete: if false;
    }

    // --- feed_posts -------------------------------------------------------
    match /feed_posts/{postId} {
      allow read: if sameFamily(resource.data.familyId);

      allow create: if isSignedIn() &&
        sameFamily(request.resource.data.familyId) &&
        (request.resource.data.authorId == request.auth.uid ||
         request.resource.data.authorId == 'system') &&
        photoWithinLimit();

      // Qualquer integrante reage, e qualquer um apaga foto já vencida; só o
      // autor apaga o próprio post.
      allow update: if sameFamily(resource.data.familyId) && (
        changedKeys().hasOnly(['reactions']) ||
        clearingExpiredPhoto()
      );

      allow delete: if isSignedIn() &&
        resource.data.authorId == request.auth.uid;
    }
  }
}
